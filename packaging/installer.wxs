<?xml version="1.0" encoding="UTF-8"?>
<!--
  Template WiX (v3) do instalador MSI. Buildado automaticamente pelo
  GitHub Actions (.github/workflows/build-agent-msi.yml, issue #107).

  UpgradeCode e o Guid do Component sao fixos e reais (gerados uma vez,
  nao trocar depois: UpgradeCode em particular precisa permanecer igual
  entre versoes pra o MajorUpgrade funcionar corretamente).

  Sem acento em nenhuma string usada em atributo (Name/Description/
  DowngradeErrorMessage/etc.) de proposito: WiX v3 usa codepage 1252 por
  padrao e um erro real (LGHT0311) ja apareceu numa run de CI por causa de
  acentuacao numa dessas strings. Comentarios XML podem ter acento
  normalmente (nao viram string table do MSI).
-->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Id="*"
           Name="Guardian Migration Agent"
           Language="1033"
           Version="0.1.0.0"
           Manufacturer="Guardian Cloud"
           UpgradeCode="86454F58-AFCC-4C1E-BEC8-EAB061B132AF">

    <Package InstallerVersion="500" Compressed="yes" InstallScope="perMachine" Platform="x64" />

    <MajorUpgrade DowngradeErrorMessage="A newer version of Guardian Migration Agent is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <!--
      Embutido pra nao depender do servidor de destino ja ter o runtime
      (comum faltar em Server Core / instalacoes enxutas). VCRedistExe e
      baixado pelo workflow do GitHub Actions antes do candle.exe/light.exe
      (nao versionado no repo, ~25MB). RegistrySearch abaixo evita rodar o
      instalador de novo se o runtime ja estiver presente.
    -->
    <Property Id="VCREDISTINSTALLED">
      <RegistrySearch Id="VCRedistRegistrySearch"
                       Root="HKLM"
                       Key="SOFTWARE\Microsoft\VisualStudio\14.0\VC\Runtimes\X64"
                       Name="Installed"
                       Type="raw" />
    </Property>

    <Binary Id="VCRedistExe" SourceFile="vc_redist.x64.exe" />

    <!--
      Return="ignore" de proposito: o instalador da Microsoft retorna
      codigos "de sucesso" que nao sao zero (3010 = reboot pendente, 1638 =
      versao igual/mais nova ja instalada), e WiX trataria isso como falha
      da Custom Action, abortando a instalacao inteira do agent por causa
      de um runtime que, na pratica, ja esta ok. A RegistrySearch acima ja
      evita a re-execucao redundante no caso comum.
    -->
    <CustomAction Id="InstallVCRedist"
                  BinaryKey="VCRedistExe"
                  ExeCommand="/quiet /norestart"
                  Execute="deferred"
                  Impersonate="no"
                  Return="ignore" />

    <!--
      Diagnostico: roda o .exe fora do Windows Service, logo apos os
      arquivos serem copiados e antes de registrar o servico. Se o
      executavel nao conseguir nem rodar nesse ambiente (bloqueio de
      politica, DLL faltando, etc), o msiexec falha aqui com o erro real
      do Windows, em vez do generico "Error 1920" que a falha do
      StartServices sempre mostra, seja qual for a causa de verdade.
      Impersonate="no" roda como LocalSystem, a mesma conta que o servico
      de verdade vai usar depois.
    -->
    <CustomAction Id="RunSelfTest"
                  FileKey="AgentExe"
                  ExeCommand="selftest"
                  Execute="deferred"
                  Impersonate="no"
                  Return="check" />

    <InstallExecuteSequence>
      <Custom Action="InstallVCRedist" Before="InstallFinalize">NOT Installed AND NOT VCREDISTINSTALLED</Custom>
      <Custom Action="RunSelfTest" After="InstallFiles">NOT Installed</Custom>
    </InstallExecuteSequence>

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLFOLDER" Name="GuardianMigrationAgent">
          <!--
            Populado em build time pelo heat.exe (harvester do WiX Toolset,
            build-agent-msi.yml) escaneando dist\guardian-migration-agent\_internal\
            (DLLs/runtime do Python, PyInstaller modo onedir). O
            ComponentGroup gerado (Id="InternalFiles") e referenciado na
            Feature abaixo.
          -->
          <Directory Id="INTERNALDIR" Name="_internal" />
        </Directory>
      </Directory>
    </Directory>

    <ComponentGroup Id="ProductComponents" Directory="INSTALLFOLDER">
      <Component Id="MainExecutable" Guid="6BD4CDD6-6675-4C67-8754-1CE294F64B8F" Win64="yes">
        <!-- Aponta pra saida do PyInstaller (build_exe.spec), modo onedir -->
        <File Id="AgentExe" Source="..\dist\guardian-migration-agent\guardian-migration-agent.exe" KeyPath="yes" />

        <!--
          Registra o proprio .exe como Windows Service. O binario congelado
          precisa saber se comportar quando iniciado pelo SCM sem
          argumentos (ver service_windows.py: win32serviceutil trata isso
          automaticamente quando o processo e iniciado pelo Service Control
          Manager).
        -->
        <ServiceInstall Id="InstallService"
                         Name="GuardianMigrationAgent"
                         DisplayName="Guardian Migration Agent"
                         Description="Guardian on-premises fileserver migration agent."
                         Type="ownProcess"
                         Start="auto"
                         ErrorControl="normal" />
        <ServiceControl Id="ControlService"
                         Name="GuardianMigrationAgent"
                         Start="install"
                         Stop="both"
                         Remove="uninstall"
                         Wait="yes" />
      </Component>
    </ComponentGroup>

    <Feature Id="MainFeature" Title="Guardian Migration Agent" Level="1">
      <ComponentGroupRef Id="ProductComponents" />
      <!-- Gerado pelo heat.exe em build time, ver comentario no INTERNALDIR acima -->
      <ComponentGroupRef Id="InternalFiles" />
    </Feature>
  </Product>
</Wix>
